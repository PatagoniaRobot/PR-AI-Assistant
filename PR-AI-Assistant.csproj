<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>PRImager.AIAssistant</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Identidad del producto -->
    <AssemblyName>PR-AI-Assistant</AssemblyName>
    <Product>PR-AI Assistant</Product>
    <Company>Patagonia Robot</Company>
    <Authors>Claudio Andino</Authors>
    <Copyright>© 2026 Patagonia Robot — Claudio Andino</Copyright>
    <Description>Asistente de IA 100% local para triaje forense digital. Parte de PRImager Forensic Core.</Description>

    <!-- Versión semántica -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0-standalone</InformationalVersion>

    <!-- Ícono de aplicación -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <Configurations>Debug;Release;Forense</Configurations>
  </PropertyGroup>

  <!--
    Búsqueda web (E2): doble barrera.
    1) Barrera de compilación: la configuración "Forense" no compila los fuentes de
       Services/WebSearch ni referencia AngleSharp. En ese binario la ausencia de red
       es literal y verificable, no un flag que alguien pueda editar en un JSON.
    2) Barrera de perfil (en runtime): UsageProfile.WebSearchEnabled, siempre pisado
       a false por OperationMode.Investigation. Ver EffectiveProfile.

    Compilar el build institucional:  dotnet build -c Forense
  -->
  <PropertyGroup>
    <EnableWebSearch Condition="'$(Configuration)' != 'Forense'">true</EnableWebSearch>
    <EnableWebSearch Condition="'$(Configuration)' == 'Forense'">false</EnableWebSearch>
    <EnableModelDownload Condition="'$(Configuration)' != 'Forense'">true</EnableModelDownload>
    <EnableModelDownload Condition="'$(Configuration)' == 'Forense'">false</EnableModelDownload>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableWebSearch)' == 'true'">
    <DefineConstants>$(DefineConstants);WEB_SEARCH</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableModelDownload)' == 'true'">
    <DefineConstants>$(DefineConstants);MODEL_DOWNLOAD</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Forense'">
    <InformationalVersion>1.0.0-forense</InformationalVersion>
    <!-- Reutiliza la configuración de Release, sin la superficie de red -->
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableWebSearch)' == 'true'">
    <PackageReference Include="AngleSharp" Version="1.7.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableWebSearch)' != 'true'">
    <Compile Remove="Services\WebSearch\**" />
    <Page Remove="Views\WebSearch\**" />
    <Compile Remove="Views\WebSearch\**" />
    <Compile Remove="ViewModels\WebSearch\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableModelDownload)' != 'true'">
    <Compile Remove="Services\HuggingFace\**" />
    <Page Remove="Views\HuggingFace\**" />
    <Compile Remove="Views\HuggingFace\**" />
    <Compile Remove="ViewModels\HuggingFace\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo_sidebar_40.png" />
    <Resource Include="Assets\logo_titlebar_24.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Prompts\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Config\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Tools\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- La ayuda se abre desde BaseDirectory\Help. Sin esto no se copiaba en el
         build y la carpeta publicada quedaba con una copia manual desactualizada. -->
    <None Update="Help\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Los avisos de terceros son una OBLIGACIÓN de las licencias MIT, Apache 2.0
         y del EULA de NVIDIA: tienen que viajar con lo que se distribuye, no
         quedarse en el repositorio. El diálogo de licencias en pantalla no
         sustituye al archivo. Mismo criterio que Help\: si no está acá, no se copia. -->
    <None Update="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Models y Tools se copian manualmente por el perito (archivos >2 GB rompen SingleFile bundle) -->
  <ItemGroup>
    <None Remove="Models\**" />
  </ItemGroup>

  <!--
    Los bancos de prueba de Tests\ son proyectos aparte y NO forman parte de la
    aplicación. Sin estas exclusiones el SDK los tomaría por los globs implícitos y
    los compilaría dentro del ejecutable: dos Main, código de prueba en el binario
    que se entrega, y la barrera de compilación arruinada, porque un banco nombra
    tipos que en Forense no deben existir.
  -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <Page Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Resource Remove="Tests\**" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>PRImager.AIAssistant</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Identidad del producto -->
    <AssemblyName>PR-AI-Assistant</AssemblyName>
    <Product>PR-AI Assistant</Product>
    <Company>Patagonia Robot</Company>
    <Authors>Claudio Andino</Authors>
    <Copyright>© 2026 Patagonia Robot — Claudio Andino</Copyright>
    <Description>Asistente de IA 100% local para triaje forense digital. Parte de PRImager Forensic Core.</Description>

    <!-- Versión semántica -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0-standalone</InformationalVersion>

    <!-- Ícono de aplicación -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo_sidebar_40.png" />
    <Resource Include="Assets\logo_titlebar_24.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Prompts\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Config\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Tools\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Models y Tools se copian manualmente por el perito (archivos >2 GB rompen SingleFile bundle) -->
  <ItemGroup>
    <None Remove="Models\**" />
  </ItemGroup>

</Project>

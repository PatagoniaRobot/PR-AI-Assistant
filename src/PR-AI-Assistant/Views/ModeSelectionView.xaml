<UserControl x:Class="PRImager.AIAssistant.Views.ModeSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PRImager.AIAssistant.Views"
             xmlns:vm="clr-namespace:PRImager.AIAssistant.ViewModels"
             xmlns:l="clr-namespace:PRImager.AIAssistant.Localization"
             xmlns:c="clr-namespace:PRImager.AIAssistant.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ModeSelectionViewModel}"
             Background="#1a1a2e" FontFamily="{StaticResource MainFont}"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Estilo base para los botones-tarjeta -->
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0f172a" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="Foreground" Value="#e2e8f0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#10B981"/>
                                <!-- Efecto de elevación sutil -->
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#10B981" BlurRadius="10" ShadowDepth="0" Opacity="0.3" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#16213E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para los botones de texto del footer -->
        <Style x:Key="FooterButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="txt" 
                                   Text="{TemplateBinding Content}" 
                                   Background="Transparent"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="txt" Property="Foreground" Value="#94a3b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BulletText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#cbd5e1"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="BulletIcon" TargetType="c:Icon">
            <Setter Property="Kind" Value="Check"/>
            <Setter Property="Size" Value="14"/>
            <Setter Property="Foreground" Value="#10B981"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,2,8,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,24">
            
            <!-- Logo / Header -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                <Image Source="pack://application:,,,/Assets/logo_sidebar_40.png"
                       Width="36" Height="36" Margin="0,0,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="PR-AI Assistant" 
                           Foreground="#10B981" 
                           FontWeight="SemiBold" 
                           FontSize="28" 
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding VersionText}" Foreground="#64748b" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,40" />

            <!-- Cards Container -->
            <WrapPanel HorizontalAlignment="Center" MaxWidth="680" ItemWidth="320">
                <!-- CARD IZQUIERDA - Modo Investigación -->
                <Button Style="{StaticResource CardButtonStyle}"
                        AutomationProperties.AutomationId="ModeInvestigationCard"
                        Command="{Binding SelectInvestigationCommand}"
                        Margin="0,0,20,20">
                    <StackPanel Margin="32">
                        <c:Icon Kind="Search" Size="48" Foreground="#e2e8f0" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="{l:T mode.investigation.title}" Foreground="#10B981" FontWeight="SemiBold" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="{l:T mode.investigation.subtitle}" Foreground="#94a3b8" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24"/>
                        
                        <StackPanel Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal"><c:Icon Style="{StaticResource BulletIcon}"/><TextBlock Text="{l:T mode.investigation.bullet1}" Style="{StaticResource BulletText}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><c:Icon Style="{StaticResource BulletIcon}"/><TextBlock Text="{l:T mode.investigation.bullet2}" Style="{StaticResource BulletText}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><c:Icon Style="{StaticResource BulletIcon}"/><TextBlock Text="{l:T mode.investigation.bullet3}" Style="{StaticResource BulletText}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><c:Icon Style="{StaticResource BulletIcon}"/><TextBlock Text="{l:T mode.investigation.bullet4}" Style="{StaticResource BulletText}"/></StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- CARD DERECHA - Modo Consulta -->
                <Button Style="{StaticResource CardButtonStyle}"
                        AutomationProperties.AutomationId="ModeConsultationCard"
                        Command="{Binding SelectConsultationCommand}"
                        Margin="0,0,0,20">
                    <StackPanel Margin="32">
                        <c:Icon Kind="Consultation" Size="48" Foreground="#e2e8f0" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="{l:T mode.consultation.title}" Foreground="#10B981" FontWeight="SemiBold" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="{l:T mode.consultation.subtitle}" Foreground="#94a3b8" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24"/>
                        
                        <StackPanel Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal"><c:Icon Style="{StaticResource BulletIcon}"/><TextBlock Text="{l:T mode.consultation.bullet1}" Style="{StaticResource BulletText}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><c:Icon Style="{StaticResource BulletIcon}"/><TextBlock Text="{l:T mode.consultation.bullet2}" Style="{StaticResource BulletText}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><c:Icon Style="{StaticResource BulletIcon}"/><TextBlock Text="{l:T mode.consultation.bullet3}" Style="{StaticResource BulletText}"/></StackPanel>
                        </StackPanel>
                        
                        <Border Background="#92400e" CornerRadius="10" Padding="12,4" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock Text="{l:T mode.consultation.badge}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <!-- Separador -->
            <Rectangle Height="1" Width="660" Fill="#334155" Margin="0,12,0,32" HorizontalAlignment="Center" />

            <!-- Selector de Modelo y Perfil -->
            <StackPanel Width="660" HorizontalAlignment="Center" Margin="0,0,0,32">
                <TextBlock Text="{l:T sidebar.model.header}" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Style="{StaticResource ModernComboBox}"
                              ItemsSource="{Binding AvailableModelItems}"
                              SelectedItem="{Binding SelectedModelItem}"
                              DisplayMemberPath="DisplayName" />
                </Grid>
                <!-- Info del modelo -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Foreground="#00D4AA" FontSize="11" Margin="0,0,6,0" Text="{Binding SelectedModelHardwareTag, Mode=OneWay}"/>
                    <TextBlock Text="{Binding SelectedModelCapabilitiesText}" Foreground="#3B82F6" FontSize="11" />
                </StackPanel>

                <!-- Ejecución -->
                <TextBlock Text="{l:T sidebar.execution.header}" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,24,0,8" />
                <ItemsControl ItemsSource="{Binding AvailableExecutionProfiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding DisplayName}"
                                    Command="{Binding DataContext.SelectExecutionProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand" FontSize="12" FontWeight="SemiBold" Margin="2,0" MinHeight="32">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Foreground" Value="#e2e8f0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="#334155"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6" Padding="8,4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#1e293b"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="#10B981"/>
                                                <Setter Property="Foreground" Value="#0f172a"/>
                                                <Setter Property="BorderBrush" Value="#10B981"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding SelectedModelContextInfo}"
                           Foreground="#64748b" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,8,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" />

                <!-- Interruptor de la generación de imágenes. Apagada, el motor no arranca
                     nunca y la sección del chat queda desactivada. No existe en Forense. -->
                <StackPanel Margin="0,24,0,0"
                            Visibility="{Binding IsImageGenCompiledIn, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{l:T sidebar.images.header}" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Border Background="#0f172a" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:Icon Grid.Column="0" Kind="GenerateImage" Size="20" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{l:T mode.images.title}" Foreground="#e2e8f0" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ImageGenSwitchText}" Foreground="#94a3b8" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,12,0"
                                           AutomationProperties.AutomationId="ImageGenSwitchText" />
                            </StackPanel>
                            <!-- Interruptor de pastilla: verde y a la derecha = encendida. -->
                            <ToggleButton Grid.Column="2" IsChecked="{Binding IsImageGenOn}" Cursor="Hand"
                                          VerticalAlignment="Center"
                                          AutomationProperties.AutomationId="ImageGenSwitch"
                                          AutomationProperties.Name="{l:T mode.images.switch}"
                                          ToolTip="{l:T mode.images.switch}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="track" Width="44" Height="24" CornerRadius="12"
                                                Background="#334155" Padding="3">
                                            <Ellipse x:Name="thumb" Width="18" Height="18" Fill="#cbd5e1"
                                                     HorizontalAlignment="Left" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="track" Property="Background" Value="#10B981" />
                                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                                                <Setter TargetName="thumb" Property="Fill" Value="White" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="track" Property="Opacity" Value="0.85" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Separador -->
            <Rectangle Height="1" Width="660" Fill="#334155" Margin="0,0,0,24" HorizontalAlignment="Center" />

            <!-- Pie de página con botones -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <Button Content="{l:T chat.help}" Style="{StaticResource FooterButtonStyle}" Command="{Binding HelpCommand}"/>
                <TextBlock Text=" · " Foreground="#64748b" FontSize="12" VerticalAlignment="Center" Margin="4,0"/>
                <Button Content="{l:T mode.licenses}" Style="{StaticResource FooterButtonStyle}" Command="{Binding LicensesCommand}"/>
                <TextBlock Text=" · " Foreground="#64748b" FontSize="12" VerticalAlignment="Center" Margin="4,0"/>
                <!-- Idioma: sigue a Windows salvo que se elija otro. Cambiarlo vuelve a abrir
                     la aplicación (Localization\Loc.cs). -->
                <c:Icon Kind="Language" Size="14" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Style="{StaticResource ModernComboBox}" MinWidth="150" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="LanguageSelector"
                          AutomationProperties.Name="{l:T mode.language}" ToolTip="{l:T mode.language}"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding SelectedLanguage}"
                          DisplayMemberPath="Label" />
            </StackPanel>

            <!-- El idioma elegido se aplica al volver a abrir -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10"
                        Visibility="{Binding IsRestartPending, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{l:T language.restart.notice}" Foreground="#F59E0B" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Content="{l:T language.restart.now}" Command="{Binding RestartCommand}"
                        AutomationProperties.AutomationId="RestartForLanguageButton"
                        Foreground="#0f172a" Background="#10B981" BorderThickness="0"
                        Padding="10,4" Cursor="Hand" FontWeight="SemiBold" />
            </StackPanel>

            <TextBlock Text="PR-AI Assistant © 2026 Patagonia Robot" 
                       Foreground="#475569" 
                       FontSize="11" 
                       HorizontalAlignment="Center" />
                       
        </StackPanel>
    </ScrollViewer>
</UserControl>

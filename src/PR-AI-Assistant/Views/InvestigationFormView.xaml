<UserControl xmlns:l="clr-namespace:PRImager.AIAssistant.Localization"
             xmlns:c="clr-namespace:PRImager.AIAssistant.Controls"
             x:Class="PRImager.AIAssistant.Views.InvestigationFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:PRImager.AIAssistant.ViewModels"
             xmlns:conv="clr-namespace:PRImager.AIAssistant.Views.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InvestigationFormViewModel}"
             Background="#1A1A2E" FontFamily="Consolas"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis"
                                        TrueValue="Collapsed" FalseValue="Visible"/>

        <!-- Estilo base para TextBox del formulario -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E3A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#2A2A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#10B981"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para Labels del formulario -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>

        <!-- Estilo para Labels opcionales -->
        <Style x:Key="FormLabelOptionalStyle" TargetType="TextBlock" BasedOn="{StaticResource FormLabelStyle}">
            <Setter Property="Foreground" Value="#AAAAAA"/>
        </Style>

        <!-- Estilo para botón principal verde -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#34D399"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botón de texto plano (Volver) -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para CheckBox del disclaimer -->
        <Style x:Key="DisclaimerCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="checkBorder"
                                    Width="18" Height="18"
                                    BorderBrush="#2A2A4A" BorderThickness="2"
                                    Background="#1E1E3A" CornerRadius="3"
                                    Margin="0,0,8,0" VerticalAlignment="Center">
                                <c:Icon x:Name="checkMark" Kind="Check" Size="14" Foreground="#10B981"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#10B981"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ═══════════════════════════════════════════ -->
        <!-- SECCIÓN 1: FORMULARIO DE IDENTIFICACIÓN    -->
        <!-- ═══════════════════════════════════════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding ShowForm, Converter={StaticResource BoolToVis}}">
            <StackPanel MaxWidth="550" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="20,40,20,40">

                <!-- Header -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <c:Icon Kind="Search" Size="26" Foreground="#10B981" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:T mode.investigation.title}"
                               Foreground="#10B981" FontWeight="Bold" FontSize="24" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{l:T form.subtitle}"
                           Foreground="#AAAAAA" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <Rectangle Height="1" Fill="#10B981" Margin="0,16,0,16"/>

                <!-- Campo: Nombre del perito -->
                <TextBlock Text="{l:T form.perito}" Style="{StaticResource FormLabelStyle}"/>
                <Grid>
                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                             Text="{Binding PeritoName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{l:T form.perito.example}"
                               Foreground="#555555" FontSize="12" FontFamily="Consolas"
                               Margin="10,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PeritoName}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Campo: Legajo -->
                <TextBlock Text="{l:T form.badge}" Style="{StaticResource FormLabelStyle}"/>
                <Grid>
                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                             Text="{Binding PeritoBadge, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{l:T form.badge.example}"
                               Foreground="#555555" FontSize="12" FontFamily="Consolas"
                               Margin="10,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PeritoBadge}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Campo: N° de causa -->
                <TextBlock Text="{l:T form.case}" Style="{StaticResource FormLabelStyle}"/>
                <Grid>
                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                             Text="{Binding CaseNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{l:T form.case.example}"
                               Foreground="#555555" FontSize="12" FontFamily="Consolas"
                               Margin="10,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CaseNumber}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Campo: Juzgado (opcional) -->
                <TextBlock Text="{l:T form.court}" Style="{StaticResource FormLabelOptionalStyle}"/>
                <Grid>
                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                             Text="{Binding Court, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{l:T form.court.example}"
                               Foreground="#555555" FontSize="12" FontFamily="Consolas"
                               Margin="10,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Court}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Campo: Descripción (opcional, multilínea) -->
                <TextBlock Text="{l:T form.description}" Style="{StaticResource FormLabelOptionalStyle}"/>
                <Grid>
                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                             Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{l:T form.description.example}"
                               Foreground="#555555" FontSize="12" FontFamily="Consolas"
                               Margin="10,6,0,0" VerticalAlignment="Top"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Description}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Texto de campos obligatorios -->
                <TextBlock Text="{l:T form.required}"
                           Foreground="#EF4444" FontSize="10" FontStyle="Italic"
                           Margin="0,8,0,0"/>

                <!-- Botón Continuar -->
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ContinueCommand}"
                        AutomationProperties.Name="{l:T form.continue}"
                        Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:T form.continue}" VerticalAlignment="Center"/>
                        <c:Icon Kind="ArrowForward" Size="16" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Botón Volver -->
                <Button Style="{StaticResource LinkButtonStyle}"
                        Command="{Binding GoBackCommand}"
                        AutomationProperties.Name="{l:T form.back}"
                        Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="ArrowBack" Size="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:T form.back}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════ -->
        <!-- SECCIÓN 2: DISCLAIMER RFC 3227             -->
        <!-- ═══════════════════════════════════════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding ShowDisclaimer, Converter={StaticResource BoolToVis}}">
            <StackPanel MaxWidth="650" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="20,40,20,40">

                <!-- Header -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <c:Icon Kind="Scales" Size="24" Foreground="#F59E0B" Accent="#F59E0B" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:T declaration.title}"
                               Foreground="#F59E0B" FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{l:T declaration.subtitle}"
                           Foreground="#AAAAAA" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,4,0,16"/>

                <!-- Cuerpo del Disclaimer -->
                <Border Background="#16213E" BorderBrush="#2A2A4A" BorderThickness="1"
                        CornerRadius="8" Padding="20">
                    <StackPanel>
                        <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto">
                            <TextBlock TextWrapping="Wrap" FontSize="11" FontFamily="Consolas"
                                       LineHeight="20">
                                <Run Foreground="#E0E0E0" Text="{l:T declaration.intro}"/>
                                <LineBreak/><LineBreak/>
                                <Run Foreground="#E0E0E0" FontWeight="Bold" Text="1. "/>
                                <Run Foreground="#EF4444" FontWeight="Bold" Text="{l:T declaration.p1.title}"/>
                                <Run Foreground="#E0E0E0" Text="{l:T declaration.p1.text}"/>
                                <LineBreak/><LineBreak/>
                                <Run Foreground="#E0E0E0" FontWeight="Bold" Text="2. "/>
                                <Run Foreground="#3B82F6" FontWeight="Bold" Text="RFC 3227"/>
                                <Run Foreground="#E0E0E0" Text="{l:T declaration.p2.text}"/>
                                <LineBreak/><LineBreak/>
                                <Run Foreground="#E0E0E0" FontWeight="Bold" Text="3. "/>
                                <Run Foreground="#10B981" FontWeight="Bold" Text="{l:T declaration.p3.title}"/>
                                <Run Foreground="#E0E0E0" Text="{l:T declaration.p3.text}"/>
                                <LineBreak/><LineBreak/>
                                <Run Foreground="#E0E0E0" FontWeight="Bold" Text="4. "/>
                                <Run Foreground="#F59E0B" FontWeight="Bold" Text="{l:T declaration.p4.title}"/>
                                <Run Foreground="#E0E0E0" Text="{l:T declaration.p4.text}"/>
                            </TextBlock>
                        </ScrollViewer>

                        <!-- Separador y datos del perito -->
                        <Rectangle Height="1" Fill="#2A2A4A" Margin="0,16,0,12"/>

                        <TextBlock FontSize="11" FontFamily="Consolas" Foreground="#00D4AA">
                            <Run Text="{l:T declaration.perito}"/><Run Text="{Binding PeritoName, Mode=OneWay}"/>
                            <Run Text="{l:T declaration.badge}"/><Run Text="{Binding PeritoBadge, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock FontSize="11" FontFamily="Consolas" Foreground="#00D4AA" Margin="0,2,0,0">
                            <Run Text="{l:T declaration.case}"/><Run Text="{Binding CaseNumber, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock FontSize="11" FontFamily="Consolas" Foreground="#AAAAAA" Margin="0,2,0,0">
                            <Run Text="{l:T declaration.date}"/><Run Text="{Binding CurrentTimestamp, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Checkbox de aceptación -->
                <CheckBox Style="{StaticResource DisclaimerCheckBoxStyle}"
                          IsChecked="{Binding DisclaimerAccepted}"
                          Margin="0,16,0,0">
                    <TextBlock Text="{l:T declaration.accept}"
                               Foreground="#E0E0E0" FontSize="12" FontFamily="Consolas"/>
                </CheckBox>

                <!-- Botón Ingresar -->
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AcceptDisclaimerCommand}"
                        AutomationProperties.Name="{l:T declaration.enter}"
                        Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:T declaration.enter}" VerticalAlignment="Center"/>
                        <c:Icon Kind="Search" Size="16" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Botón Volver al formulario -->
                <Button Style="{StaticResource LinkButtonStyle}"
                        Command="{Binding BackToFormCommand}"
                        AutomationProperties.Name="{l:T declaration.backToForm}"
                        Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="ArrowBack" Size="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:T declaration.backToForm}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

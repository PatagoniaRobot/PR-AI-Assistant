<Window x:Class="PRImager.AIAssistant.Views.FolderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:conv="clr-namespace:PRImager.AIAssistant.Views.Converters"
        xmlns:vm="clr-namespace:PRImager.AIAssistant.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FolderSettingsViewModel}"
        xmlns:l="clr-namespace:PRImager.AIAssistant.Localization"
        Title="{l:T folders.window.title}"
        Height="700" Width="880"
        Background="#1A1A2E"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource MainFont}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToVisibilityConverter x:Key="TextToVis" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94a3b8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="FolderButton" TargetType="Button">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#374151" />
                                <Setter Property="Foreground" Value="#6B7280" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeutralFolderButton" TargetType="Button" BasedOn="{StaticResource FolderButton}">
            <Setter Property="Background" Value="#334155" />
        </Style>

        <Style x:Key="DangerFolderButton" TargetType="Button" BasedOn="{StaticResource FolderButton}">
            <Setter Property="Background" Value="#DC2626" />
        </Style>

        <Style x:Key="RutaBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0f172a" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <!-- Wrap y no NoWrap: la ruta es el contenido de esta ventana, y una ruta a un
                 disco distinto es larga justamente en el caso que motivó todo esto. Con
                 NoWrap el final quedaba cortado contra el borde del campo y había que
                 desplazarse adentro del TextBox para leerla. Lo mostró la captura. -->
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{l:T sidebar.folders.button}" FontSize="18" FontWeight="Bold" />
            <TextBlock Foreground="#94a3b8" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="{l:T sidebar.folders.tooltip}" />
            <TextBlock Foreground="#94a3b8" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="FolderRuleText"
                       Text="{l:T folders.changeHint}" />
        </StackPanel>

        <!-- Las carpetas. Va en un ScrollViewer porque el panel de movimiento de una fila
             puede crecer bastante, y el pie queda AFUERA del scroll: en la vista de
             generación el botón principal se iba abajo del área visible al desplegar los
             ajustes y no lo detectó ninguna aserción, lo mostró la captura. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Aviso de edición sin carpetas configurables. La edición institucional no
                     descarga modelos ni genera imágenes, así que no tiene ninguna. -->
                <TextBlock Text="{l:T folders.notManaged}"
                           Foreground="#94a3b8" FontSize="12" Margin="0,8,0,0"
                           AutomationProperties.AutomationId="FolderEmptyText"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                <ItemsControl ItemsSource="{Binding Folders}"
                              AutomationProperties.AutomationId="FolderList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0f172a" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Foreground="#94a3b8"
                                               FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Path, Mode=OneWay}"
                                                 Style="{StaticResource RutaBox}"
                                                 ToolTip="{Binding Path}" />
                                        <Button Grid.Column="1" Content="{l:T common.browse}" Margin="8,0,0,0"
                                                Style="{StaticResource FolderButton}"
                                                Command="{Binding DataContext.ChangeFolderCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="2" Content="{l:T folders.open}" Margin="6,0,0,0"
                                                Style="{StaticResource NeutralFolderButton}"
                                                Command="{Binding DataContext.OpenFolderCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>

                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ContentsText}"
                                                   Foreground="#94a3b8" FontSize="11"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="{l:T folders.reset}"
                                                FontSize="11" Padding="10,4"
                                                Style="{StaticResource NeutralFolderButton}"
                                                Command="{Binding DataContext.ResetToDefaultCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>

                                    <!-- El aviso de bin\. Era el pendiente 6.3: acá adentro,
                                         una limpieza de compilación se lleva los modelos. -->
                                    <Border Background="#3f2d1a" CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
                                            Visibility="{Binding WarningText, Converter={StaticResource TextToVis}}">
                                        <TextBlock Text="{Binding WarningText}" Foreground="#fbbf24"
                                                   FontSize="11" TextWrapping="Wrap" />
                                    </Border>

                                    <!-- Movimiento pendiente -->
                                    <Border Background="#132033" CornerRadius="4" Padding="10" Margin="0,8,0,0"
                                            Visibility="{Binding HasPendingMove, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding PendingText}" FontSize="11"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding PreviousFolder}" Foreground="#94a3b8"
                                                       FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap" />

                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                                                <Button Content="{l:T folders.move}"
                                                        Style="{StaticResource FolderButton}"
                                                        Command="{Binding DataContext.MoveCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="{l:T folders.leave}" Margin="8,0,0,0"
                                                        Style="{StaticResource NeutralFolderButton}"
                                                        Command="{Binding DataContext.DismissPendingCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>

                                            <!-- En curso -->
                                            <StackPanel Visibility="{Binding IsMoving, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding MoveStatus}" Foreground="#00D4AA"
                                                           FontSize="11" TextWrapping="Wrap" />
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ProgressBar Grid.Column="0" Height="6" Maximum="100"
                                                                 VerticalAlignment="Center"
                                                                 Value="{Binding MovePercent, Mode=OneWay}"
                                                                 Background="#1e293b" Foreground="#10B981"
                                                                 BorderThickness="0" />
                                                    <Button Grid.Column="1" Content="{l:T common.cancel}" Margin="8,0,0,0"
                                                            FontSize="11" Padding="10,4"
                                                            Style="{StaticResource DangerFolderButton}"
                                                            Command="{Binding DataContext.CancelMoveCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Resultado del último movimiento -->
                                    <TextBlock Text="{Binding ResultText}" Foreground="#00D4AA" FontSize="11"
                                               Margin="0,8,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding ResultText, Converter={StaticResource TextToVis}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Pie, fuera del scroll -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Message}" Foreground="#94a3b8" FontSize="11"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="FolderMessage" />
            <Button Grid.Column="1" Content="{l:T common.close}" Style="{StaticResource NeutralFolderButton}"
                    Click="Cerrar_Click"
                    AutomationProperties.AutomationId="FolderCloseButton" />
        </Grid>
    </Grid>
</Window>

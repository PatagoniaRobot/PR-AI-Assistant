<Application x:Class="PRImager.AIAssistant.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PRImager.AIAssistant"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ModernControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Tipografía Dual -->
            <FontFamily x:Key="MainFont">Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFont">Consolas</FontFamily>
            
            <Style TargetType="Control">
                <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
            </Style>
            <!-- Tema oscuro global -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1A1A2E" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

<UserControl x:Class="PRImager.AIAssistant.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:PRImager.AIAssistant.Views.Converters"
             xmlns:vm="clr-namespace:PRImager.AIAssistant.ViewModels"
             xmlns:helpers="clr-namespace:PRImager.AIAssistant.Helpers"
             xmlns:l="clr-namespace:PRImager.AIAssistant.Localization"
             xmlns:c="clr-namespace:PRImager.AIAssistant.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             Background="#1A1A2E" FontFamily="{StaticResource MainFont}"
             AllowDrop="True" Drop="ChatView_Drop">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:ServerStatusToColorConverter x:Key="StatusToColor" />
        <conv:HexToBrushConverter x:Key="HexToBrush" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
            <Setter Property="Foreground" Value="#E0E0E0" />
        </Style>

        <Style x:Key="EmptyChatWelcomeStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Estilos de botones básicos -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#34D399"/></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                                <Setter TargetName="border" Property="Margin" Value="1,1,-1,-1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EF4444"/>
            <Setter Property="BorderBrush" Value="#EF4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A0000"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#330000"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#60A5FA"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#2563EB"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CircularActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#34D399"/></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                                <Setter TargetName="border" Property="Margin" Value="1,1,-1,-1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransparentHoverButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#2A2A4A"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Background" Value="#1A1A2E"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#e2e8f0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#1e293b"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Background" Value="#0f172a"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="0" x:Name="RightPanelColumn" />
        </Grid.ColumnDefinitions>

        <!-- PANEL CENTRAL (Chat principal) -->
        <Grid Grid.Column="0" Background="#1A1A2E">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Franja de acento del perfil activo: identificación visual inconfundible (E1) -->
            <Border Grid.Row="0" Height="4"
                    Background="{Binding AccentColor, Converter={StaticResource HexToBrush}}"
                    ToolTip="{Binding ProfileName, StringFormat={l:T chat.activeProfileFormat}}" />

            <!-- A. Header Mínimo -->
            <Border Grid.Row="1" Background="#0f172a" BorderBrush="#334155" BorderThickness="0,0,0,1" Height="48">
                <Grid>
                    <!-- Izquierda: Hamburger + selector de perfil -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Style="{StaticResource HeaderIconButton}" Padding="10,8"
                                AutomationProperties.AutomationId="MenuButton"
                                AutomationProperties.Name="{l:T chat.menu}" ToolTip="{l:T chat.menu}"
                                Command="{Binding ToggleSidebarCommand}">
                            <c:Icon Kind="Menu" Size="20" />
                        </Button>

                        <!-- Punto de color: repite el acento junto al nombre del perfil -->
                        <Ellipse Width="10" Height="10" Margin="12,0,6,0" VerticalAlignment="Center"
                                 Fill="{Binding AccentColor, Converter={StaticResource HexToBrush}}" />
                        <ComboBox Style="{StaticResource ModernComboBox}"
                                  AutomationProperties.AutomationId="ProfileSelector"
                                  ItemsSource="{Binding AvailableUsageProfiles}"
                                  SelectedItem="{Binding SelectedUsageProfile}"
                                  DisplayMemberPath="Name"
                                  MinWidth="140" VerticalAlignment="Center"
                                  ToolTip="{l:T chat.profileSelector}" />
                        <Button Style="{StaticResource HeaderIconButton}" Padding="8,6"
                                AutomationProperties.AutomationId="ManageProfilesButton"
                                AutomationProperties.Name="{l:T chat.manageProfiles}"
                                Margin="4,0,0,0" Command="{Binding ManageProfilesCommand}"
                                ToolTip="{l:T chat.manageProfiles}">
                            <c:Icon Kind="Settings" Size="18" />
                        </Button>
                    </StackPanel>

                    <!-- Centro: nombre del perfil activo, en grande -->
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="Bold" FontSize="14"
                               Foreground="{Binding AccentColor, Converter={StaticResource HexToBrush}}"
                               Text="{Binding ProfileName, StringFormat=● {0}}" />

                    <!-- Derecha: Pills y Botones -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                        <!-- Pill Sandbox -->
                        <Border Background="#92400e" Padding="12,4" CornerRadius="12" Margin="0,0,12,0"
                                Visibility="{Binding ShowModeBadge, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="Lock" Size="14" Foreground="White" Accent="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{l:T chat.badge.sandbox}" Foreground="White" FontWeight="SemiBold" FontSize="12" FontFamily="{StaticResource MainFont}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <!-- Pill Investigación -->
                        <Border Background="#065f46" Padding="12,4" CornerRadius="12" Margin="0,0,12,0"
                                Visibility="{Binding IsInvestigationMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="Search" Size="14" Foreground="White" Accent="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{l:T chat.badge.investigation}" Foreground="White" FontWeight="SemiBold" FontSize="12" FontFamily="{StaticResource MainFont}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource HeaderIconButton}" Padding="8,6" Click="OpenHelp_Click"
                                AutomationProperties.AutomationId="HelpButton"
                                AutomationProperties.Name="{l:T chat.help}" ToolTip="{l:T chat.help}">
                            <c:Icon Kind="Help" Size="20" />
                        </Button>

                        <Button Margin="8,0,0,0"
                                Foreground="#00D4AA" Style="{StaticResource HeaderIconButton}" Padding="8,4"
                                Click="ToggleRightPanel_Click"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="Document" Size="16" Margin="0,0,6,0" />
                                <TextBlock Text="{l:T context.title}" Foreground="#00D4AA" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Área de chat -->
            <Grid Grid.Row="2">
                <Grid Style="{StaticResource EmptyChatWelcomeStyle}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    
                    <!-- Estado 1: Servidor iniciando -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ServerStatus}" Value="Starting">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ServerStatus}" Value="LoadingModel">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.6" BeginTime="0:0:0.0" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.6" BeginTime="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse Width="10" Height="10" Fill="#10B981">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.6" BeginTime="0:0:0.4" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </StackPanel>

                        <TextBlock Text="{l:T chat.startingModel}" FontFamily="{StaticResource MainFont}" FontSize="16" FontWeight="SemiBold" Foreground="#94a3b8" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedModelItem.DisplayName}" FontFamily="{StaticResource MainFont}" FontSize="13" Foreground="#64748b" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Estado 0: primer arranque, sin ningún modelo. PR-AIA se publica sin
                         modelos: esto es lo primero que ve quien lo baja. -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560"
                                AutomationProperties.AutomationId="FirstRunGuide">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAvailableModel}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{l:T chat.firstRun.title}" FontFamily="{StaticResource MainFont}" FontSize="18"
                                   FontWeight="SemiBold" Foreground="#e2e8f0" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding FirstRunText}" FontFamily="{StaticResource MainFont}" FontSize="14"
                                   Foreground="#94a3b8" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,18"
                                   AutomationProperties.AutomationId="FirstRunText" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Command="{Binding OpenModelCatalogCommand}"
                                    Style="{StaticResource ActionButtonStyle}" Padding="16,8" Margin="4,0"
                                    AutomationProperties.AutomationId="FirstRunCatalogButton"
                                    AutomationProperties.Name="{l:T chat.firstRun.openCatalog}"
                                    Visibility="{Binding IsModelDownloadAvailable, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Kind="Download" Size="16" Accent="White" Margin="0,0,6,0" />
                                    <TextBlock Text="{l:T chat.firstRun.openCatalog}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                            <Button Content="{l:T chat.firstRun.useGeneral}" Command="{Binding UseGeneralProfileCommand}"
                                    Style="{StaticResource ActionButtonStyle}" Padding="16,8" Margin="4,0"
                                    AutomationProperties.AutomationId="FirstRunGeneralButton"
                                    Visibility="{Binding CanSwitchToGeneralForDownload, Converter={StaticResource BoolToVis}}" />
                            <Button Command="{Binding OpenModelsFolderCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="16,8" Margin="4,0"
                                    AutomationProperties.AutomationId="FirstRunFolderButton"
                                    AutomationProperties.Name="{l:T chat.firstRun.openFolder}">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Kind="Folder" Size="16" Accent="White" Margin="0,0,6,0" />
                                    <TextBlock Text="{l:T chat.firstRun.openFolder}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Estado 2: Servidor listo -->
                    <TextBlock Foreground="#64748b" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ServerStatus}" Value="Ready">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <!-- Fallback en caso de ServerStatus == Stopped sin error -->
                                    <DataTrigger Binding="{Binding ServerStatus}" Value="Stopped">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <!-- Sin modelo no está «listo»: manda el Estado 0. Va último para ganar -->
                                    <DataTrigger Binding="{Binding HasAvailableModel}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <InlineUIContainer BaselineAlignment="Center"><c:Icon Kind="Monitor" Size="20" Foreground="#94a3b8" Margin="0,0,8,0" /></InlineUIContainer>
                        <Run Text="{l:T chat.ready.title}" FontSize="16" FontFamily="{StaticResource MainFont}" />
                        <LineBreak />
                        <Run Text="{l:T chat.ready.hint}" FontSize="14" FontFamily="{StaticResource MainFont}" />
                    </TextBlock>

                    <!-- Estado 3: Error al iniciar -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ServerStatus}" Value="Error">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <c:Icon Kind="Warning" Size="20" Foreground="#ef4444" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T chat.error.title}" FontFamily="{StaticResource MainFont}" FontSize="16" FontWeight="SemiBold" Foreground="#ef4444" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding StartupError}" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="#94a3b8" HorizontalAlignment="Center" Margin="0,8,0,16" TextWrapping="Wrap" MaxWidth="600" TextAlignment="Center" />
                        <TextBlock Text="{l:T chat.error.hint}" FontFamily="{StaticResource MainFont}" FontSize="13" Foreground="#64748b" HorizontalAlignment="Center" />
                    </StackPanel>

                </Grid>

                <ScrollViewer x:Name="ChatScrollViewer" ScrollChanged="ScrollViewer_ScrollChanged" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Messages}" Margin="20">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,15,0,15">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsUser}" Value="False" />
                                                        <Condition Binding="{Binding IsSystem}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <!-- User Bubble -->
                                    <Border CornerRadius="12,12,2,12" Padding="16,12,16,12" MaxWidth="800" Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1e3a5f" />
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding ImagePaths}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Rectangle Width="40" Height="40" Fill="#1E1E3A" Margin="0,0,5,5" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{Binding Content}" Foreground="#e2e8f0" FontSize="15" FontFamily="{StaticResource MainFont}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Foreground="#64748b" FontSize="11" FontFamily="{StaticResource MainFont}" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Assistant Bubble -->
                                    <Border CornerRadius="12,12,12,2" Padding="16,12,16,12" MaxWidth="850" Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVis}}" Background="#0f172a" BorderBrush="#1e293b" BorderThickness="1">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{l:T chat.thinking}" Foreground="#10B981" FontFamily="{StaticResource MainFont}" FontStyle="Italic" FontSize="14" Visibility="{Binding IsWaitingForFirstToken, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                                    <TextBlock.Triggers>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.3" Duration="0:0:1" AutoReverse="True" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </TextBlock.Triggers>
                                                </TextBlock>

                                                <RichTextBox Grid.Column="0"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             IsReadOnly="True"
                                                             IsDocumentEnabled="False"
                                                             Foreground="#cbd5e1"
                                                             FontFamily="{StaticResource MainFont}"
                                                             FontSize="15"
                                                             Padding="0"
                                                             IsTabStop="False"
                                                             FocusVisualStyle="{x:Null}"
                                                             Visibility="{Binding IsWaitingForFirstToken, Converter={StaticResource InverseBoolToVis}}"
                                                             helpers:RichTextBoxHelper.RenderMode="{Binding RenderMode}"
                                                             helpers:RichTextBoxHelper.Content="{Binding Content}">
                                                    <RichTextBox.Resources>
                                                        <Style TargetType="Paragraph">
                                                            <Setter Property="Margin" Value="0,0,0,8" />
                                                        </Style>
                                                        <Style TargetType="Table">
                                                            <Setter Property="CellSpacing" Value="0" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Setter Property="BorderBrush" Value="#334155" />
                                                            <Setter Property="Margin" Value="0,8,0,8" />
                                                            <Setter Property="Foreground" Value="#e2e8f0" />
                                                        </Style>
                                                        <Style TargetType="TableCell">
                                                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                                                            <Setter Property="BorderBrush" Value="#334155" />
                                                            <Setter Property="Padding" Value="8,6" />
                                                        </Style>
                                                    </RichTextBox.Resources>
                                                </RichTextBox>
                                                <TextBlock Grid.Column="1" Text="▌" Foreground="#00D4AA" FontSize="15" Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}" VerticalAlignment="Bottom" Margin="2,0,0,0" />
                                            </Grid>

                                            <!-- Fuentes web usadas: colapsable, con URL clickeable para verificar -->
                                            <Expander Margin="0,10,0,0"
                                                      IsExpanded="{Binding AreSourcesExpanded}"
                                                      Visibility="{Binding HasWebSources, Converter={StaticResource BoolToVis}}"
                                                      Foreground="#93c5fd" Background="Transparent">
                                                <Expander.Header>
                                                    <TextBlock Text="{Binding WebSourcesHeader}" Foreground="#93c5fd"
                                                               FontSize="12" FontWeight="SemiBold" />
                                                </Expander.Header>
                                                <ItemsControl ItemsSource="{Binding WebSources}" Margin="0,8,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#111827" BorderBrush="#1e293b" BorderThickness="1"
                                                                    CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Index, StringFormat=[{0}]}"
                                                                                   Foreground="#3B82F6" FontWeight="Bold"
                                                                                   FontSize="12" Margin="0,0,6,0" />
                                                                        <TextBlock Text="{Binding Title}" Foreground="#e2e8f0"
                                                                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                                                                   MaxWidth="600" />
                                                                    </StackPanel>
                                                                    <TextBlock Margin="22,2,0,0">
                                                                        <Hyperlink NavigateUri="{Binding Url}"
                                                                                   RequestNavigate="Source_RequestNavigate"
                                                                                   Foreground="#60a5fa">
                                                                            <Run Text="{Binding Url, Mode=OneWay}" FontSize="11" />
                                                                        </Hyperlink>
                                                                    </TextBlock>
                                                                    <StackPanel Orientation="Horizontal" Margin="22,2,0,0">
                                                                        <TextBlock Text="{Binding PublishedDate}" Foreground="#64748b" FontSize="10" />
                                                                        <TextBlock Text=" · " Foreground="#64748b" FontSize="10" />
                                                                        <TextBlock Text="{Binding StatusText}" FontSize="10">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="#10B981" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding WasRead}" Value="False">
                                                                                            <Setter Property="Foreground" Value="#F59E0B" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>

                                            <StackPanel Visibility="{Binding HasDisclaimer, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                                <Rectangle Height="1" Fill="#334155" Margin="0,0,0,8" />
                                                <TextBlock Foreground="#475569" FontSize="11" FontFamily="{StaticResource MainFont}" TextWrapping="Wrap">
                                                    <Run Text="{l:T chat.disclaimer.label}" FontWeight="SemiBold" />
                                                    <Run Text="{Binding DisclaimerText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            
                                            <Grid Margin="0,4,0,0">
                                                <TextBlock Text="{Binding GenerationMetrics}" FontFamily="{StaticResource MonoFont}" Foreground="#10B981" FontSize="11" HorizontalAlignment="Left" />
                                                <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Foreground="#64748b" FontSize="11" FontFamily="{StaticResource MainFont}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- System Bubble -->
                                    <Border CornerRadius="8" Padding="12" MaxWidth="600" Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}" Background="#2A2A4A" BorderBrush="#777777" BorderThickness="1">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <c:Icon Kind="{Binding IconKind}" Size="14" Margin="0,0,6,0" VerticalAlignment="Top"
                                                        Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding Content}" Foreground="#E0E0E0" FontSize="11" FontStyle="Italic" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Foreground="#AAAAAA" FontSize="9" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Barra de input -->
            <Border Grid.Row="3" Background="#16213E" Padding="12">
                <StackPanel>
                <!-- Progreso de la búsqueda web: Buscando… / Leyendo N páginas… -->
                <Border Background="#1e3a5f" CornerRadius="6" Padding="10,6" Margin="0,0,0,8"
                        Visibility="{Binding IsWebSearchRunning, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Kind="Globe" Size="16" Foreground="#93c5fd" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding WebSearchStatus}" Foreground="#93c5fd" FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <!-- Adjuntos del próximo mensaje (Modo General). No es el panel de
                     contexto forense: eso es evidencia y vive a la derecha. Estos son
                     del turno y desaparecen al enviar. -->
                <ItemsControl ItemsSource="{Binding PendingAttachments}" Margin="0,0,0,8"
                              AutomationProperties.AutomationId="PendingAttachmentsStrip"
                              Visibility="{Binding HasPendingAttachments, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1e293b" BorderBrush="#334155" BorderThickness="1"
                                    CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Kind="{Binding IconKind}" Size="14" Foreground="#cbd5e1" VerticalAlignment="Center"
                                            Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding FileName}" Foreground="#E0E0E0" FontSize="11"
                                               VerticalAlignment="Center" MaxWidth="220"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FilePath}" />
                                    <TextBlock Text="{Binding FileSizeFormatted}" Foreground="#64748b"
                                               FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    <Button Command="{Binding RemoveCommand}"
                                            Style="{StaticResource TransparentHoverButton}"
                                            Width="20" Height="20" Margin="6,0,0,0"
                                            AutomationProperties.AutomationId="RemoveAttachmentButton"
                                            AutomationProperties.Name="{l:T chat.attachment.remove}"
                                            ToolTip="{l:T chat.attachment.remove}">
                                        <c:Icon Kind="Close" Size="12" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding LoadFilesCommand}"
                            Style="{StaticResource TransparentHoverButton}" Width="40" Height="40" Margin="0,0,5,0"
                            AutomationProperties.AutomationId="AttachFilesButton"
                            AutomationProperties.Name="{l:T chat.attachFiles}" ToolTip="{l:T chat.attachFiles}"
                            Visibility="{Binding ShowFileButtons, Converter={StaticResource BoolToVis}}">
                        <c:Icon Kind="Attach" Size="20" Foreground="#cbd5e1" />
                    </Button>
                    <Button Grid.Column="1" Command="{Binding LoadImagesCommand}"
                            Style="{StaticResource TransparentHoverButton}" Width="40" Height="40" Margin="0,0,10,0"
                            AutomationProperties.AutomationId="AttachImagesButton"
                            AutomationProperties.Name="{l:T chat.attachImages}" ToolTip="{l:T chat.attachImages}"
                            Visibility="{Binding ShowFileButtons, Converter={StaticResource BoolToVis}}">
                        <c:Icon Kind="Image" Size="20" Foreground="#cbd5e1" />
                    </Button>

                    <!-- Toggle de búsqueda web: el usuario decide cuándo buscar, no el modelo.
                         Solo existe si el binario la incluye; solo se habilita si el perfil efectivo la permite. -->
                    <ToggleButton Grid.Column="2" x:Name="WebSearchToggle"
                                  AutomationProperties.AutomationId="WebSearchToggle"
                                  IsChecked="{Binding IsWebSearchOn}"
                                  IsEnabled="{Binding IsWebSearchAvailable}"
                                  ToolTip="{Binding WebSearchToggleTooltip}"
                                  Visibility="{Binding IsWebSearchCompiledIn, Converter={StaticResource BoolToVis}}"
                                  Width="40" Height="40" Margin="0,0,10,0" Cursor="Hand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#94a3b8"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8">
                                                <c:Icon Kind="Globe" Size="20" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <Border Grid.Column="3" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="{l:T chat.input.placeholder}" 
                                       Foreground="#64748b" FontFamily="{StaticResource MainFont}" FontSize="15"
                                       Margin="12,10,12,10" IsHitTestVisible="False" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UserInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UserInput}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="ChatInput"
                                     Background="Transparent" BorderThickness="0" Foreground="#E0E0E0"
                                     TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="120"
                                     FontSize="15" FontFamily="{StaticResource MainFont}"
                                     Padding="12,10,12,10" VerticalScrollBarVisibility="Auto"
                                     PreviewKeyDown="ChatInput_PreviewKeyDown" />
                        </Grid>
                    </Border>

                    <!-- Botón Enviar / Cancelar -->
                    <!-- Padding 0: el estilo base trae 16 a cada lado, y en un botón de 40
                         dejaba 8 px para el ícono, que salía cortado en una medialuna. -->
                    <Button Grid.Column="4" Width="40" Height="40" Margin="10,0,0,0" Padding="0"
                            AutomationProperties.AutomationId="SendButton">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CircularActionButtonStyle}">
                                <Setter Property="Command" Value="{Binding SendMessageCommand}" />
                                <Setter Property="ToolTip" Value="{l:T chat.send}" />
                                <Setter Property="AutomationProperties.Name" Value="{l:T chat.send}" />
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <c:Icon Kind="Send" Size="18" Accent="White" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                        <Setter Property="Command" Value="{Binding CancelCommand}" />
                                        <Setter Property="ToolTip" Value="{l:T chat.cancel}" />
                                        <Setter Property="AutomationProperties.Name" Value="{l:T chat.cancel}" />
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <c:Icon Kind="Stop" Size="18" Accent="White" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Background" Value="#EF4444" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- B. Overlay Sidebar -->
        <Grid Grid.Column="0" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
            <!-- Capa oscura -->
            <Button Background="#99000000" BorderThickness="0" Command="{Binding ToggleSidebarCommand}" Cursor="Arrow">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            
            <!-- Panel Drawer -->
            <Border Width="280" HorizontalAlignment="Left" Background="#0f172a" BorderBrush="#334155" BorderThickness="0,0,1,0" Padding="16">
                <!-- Se puede agregar animación con EventTriggers, pero por simplicidad de compatibilidad usamos Visibility standard -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Botón Cerrar (X) -->
                    <Button Grid.Row="0" Command="{Binding ToggleSidebarCommand}" Style="{StaticResource HeaderIconButton}" HorizontalAlignment="Right" Padding="8,6" Margin="0,0,-8,0"
                            AutomationProperties.AutomationId="CloseSidebarButton"
                            AutomationProperties.Name="{l:T sidebar.close}" ToolTip="{l:T sidebar.close}">
                        <c:Icon Kind="Close" Size="16" />
                    </Button>

                    <!-- Info de sesión de investigación (solo visible en modo investigación) -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,24" Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SessionPeritoText}" Foreground="#AAAAAA" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SessionCaseText}" Foreground="#AAAAAA" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Botón Nueva Sesión -->
                    <Button Grid.Row="2" Command="{Binding ClearHistoryCommand}" Style="{StaticResource ActionButtonStyle}" MinHeight="35" Margin="0,0,0,24">
                        <TextBlock Text="{l:T sidebar.newSession}" FontWeight="SemiBold" />
                    </Button>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Perfil de uso activo -->
                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="{l:T sidebar.profile.header}" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Rectangle Width="4" Height="16" Margin="0,0,8,0"
                                               Fill="{Binding AccentColor, Converter={StaticResource HexToBrush}}" />
                                    <TextBlock Text="{Binding ProfileName}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="{Binding ProfileOverrideNotice}" Foreground="#F59E0B" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,0,0,8"
                                           Visibility="{Binding IsProfilePromptOverridden, Converter={StaticResource BoolToVis}}" />
                                <Button Command="{Binding ManageProfilesCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                        Background="#1E1E3A" MinHeight="28">
                                    <TextBlock Text="{l:T chat.manageProfiles}" FontSize="11" />
                                </Button>
                            </StackPanel>

                            <!-- 3. Sección Estado del Servidor -->
                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="{l:T sidebar.server.header}" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Ellipse Width="12" Height="12" Fill="{Binding ServerStatus, Converter={StaticResource StatusToColor}}" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding ServerStatusText}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{Binding StartServerCommand}" Style="{StaticResource ActionButtonStyle}" MinHeight="25"
                                            AutomationProperties.AutomationId="StartServerButton"
                                            AutomationProperties.Name="{l:T sidebar.server.start}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:Icon Kind="Play" Size="14" Accent="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{l:T sidebar.server.start}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding StopServerCommand}" Style="{StaticResource DangerButtonStyle}" MinHeight="25"
                                            AutomationProperties.AutomationId="StopServerButton"
                                            AutomationProperties.Name="{l:T sidebar.server.stop}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:Icon Kind="Stop" Size="14" Accent="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{l:T sidebar.server.stop}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- 4. Sección Modelo + Parámetros -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="{l:T sidebar.model.header}" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              Style="{StaticResource ModernComboBox}"
                                              ItemsSource="{Binding AvailableModelItems}"
                                              SelectedItem="{Binding SelectedModelItem}"
                                              DisplayMemberPath="DisplayName"
                                              Margin="0,0,5,0" />
                                    <Button Grid.Column="1" Command="{Binding RefreshModelsCommand}" Padding="0"
                                            AutomationProperties.AutomationId="RefreshModelsButton"
                                            AutomationProperties.Name="{l:T sidebar.model.refresh}" ToolTip="{l:T sidebar.model.refresh}"
                                            Style="{StaticResource SecondaryButtonStyle}" Background="#1E1E3A">
                                        <c:Icon Kind="Refresh" Size="16" />
                                    </Button>
                                </Grid>

                                <!-- Catálogo de HuggingFace: solo si el binario lo incluye
                                     y el perfil efectivo habilita descargas -->
                                <Button Command="{Binding OpenModelCatalogCommand}"
                                        AutomationProperties.AutomationId="OpenCatalogButton"
                                        Style="{StaticResource SecondaryButtonStyle}" Background="#1E1E3A"
                                        MinHeight="28" Margin="0,6,0,0"
                                        Visibility="{Binding IsModelCatalogCompiledIn, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:Icon Kind="Download" Size="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{l:T sidebar.model.catalog}" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <!-- Info del modelo seleccionado -->
                                <TextBlock Foreground="#00D4AA" FontSize="9" Margin="0,6,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#00D4AA"/>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding SelectedModelHardwareTag, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding SelectedModelCapabilitiesText}" Foreground="#3B82F6" FontSize="9" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding SelectedModelContextInfo}" Foreground="#777777" FontFamily="{StaticResource MonoFont}" FontSize="9" Margin="0,2,0,0" TextWrapping="Wrap" />

                                <!-- Generación de imágenes (E4): dos barreras.
                                     La sección entera desaparece si el binario no la
                                     incluye -edición Forense-, y los botones se
                                     deshabilitan si el perfil efectivo no la permite.
                                     Que se vean deshabilitados y no ocultos es
                                     deliberado: el usuario tiene que poder descubrir que
                                     la capacidad existe y que su perfil se la quita. -->
                                <StackPanel Margin="0,16,0,0"
                                            Visibility="{Binding IsImageGenCompiledIn, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{l:T sidebar.images.header}" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Button Command="{Binding OpenImageGenerationCommand}"
                                            AutomationProperties.AutomationId="OpenImageGenButton"
                                            Style="{StaticResource SecondaryButtonStyle}" Background="#1E1E3A"
                                            MinHeight="28"
                                            ToolTip="{l:T sidebar.images.generate.tooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:Icon Kind="GenerateImage" Size="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{l:T sidebar.images.generate}" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding OpenImagePackagesCommand}"
                                            AutomationProperties.AutomationId="OpenImagePackagesButton"
                                            Style="{StaticResource SecondaryButtonStyle}" Background="#1E1E3A"
                                            MinHeight="28" Margin="0,6,0,0"
                                            ToolTip="{l:T sidebar.images.packages.tooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:Icon Kind="Download" Size="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{l:T sidebar.images.packages}" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{l:T sidebar.images.disabled}"
                                               Foreground="#F59E0B" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"
                                               AutomationProperties.AutomationId="ImageGenDisabledNotice"
                                               Visibility="{Binding IsImageGenAvailable, Converter={StaticResource InverseBoolToVis}}" />
                                </StackPanel>

                                <!-- Carpetas de datos. La sección entera desaparece cuando
                                     la edición no administra ninguna: la institucional no
                                     descarga modelos ni genera imágenes, así que no tiene
                                     ninguna carpeta de datos del usuario que elegir. Acá se
                                     oculta en lugar de deshabilitar, al revés que arriba,
                                     porque no hay ninguna capacidad que descubrir: no es
                                     que el perfil la quite, es que no existe. -->
                                <StackPanel Margin="0,16,0,0"
                                            Visibility="{Binding AreFoldersConfigurable, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{l:T sidebar.folders.header}" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Button Command="{Binding OpenFolderSettingsCommand}"
                                            AutomationProperties.AutomationId="OpenFolderSettingsButton"
                                            Style="{StaticResource SecondaryButtonStyle}" Background="#1E1E3A"
                                            MinHeight="28"
                                            ToolTip="{l:T sidebar.folders.tooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:Icon Kind="Folder" Size="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{l:T sidebar.folders.button}" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Perfil de ejecución: toggle buttons -->
                                <TextBlock Text="{l:T sidebar.execution.header}" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,16,0,8" />
                                <ItemsControl ItemsSource="{Binding AvailableExecutionProfiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding DisplayName}"
                                                    Command="{Binding DataContext.SelectExecutionProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand" FontSize="9" FontWeight="SemiBold" Margin="1,0" MinHeight="26">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Foreground" Value="#e2e8f0"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="BorderBrush" Value="#334155"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="4,3">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#1E293B"/></Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="#10B981"/>
                                                                <Setter Property="Foreground" Value="#0f172a"/>
                                                                <Setter Property="BorderBrush" Value="#10B981"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{l:T sidebar.params.header}" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,16,0,8" />
                                <CheckBox IsChecked="{Binding EnableThinking}" Foreground="#E0E0E0" Margin="0,0,0,15">
                                    <TextBlock Text="{l:T sidebar.params.thinking}" Margin="5,0,0,0" />
                                </CheckBox>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="{l:T sidebar.params.temperature}" Foreground="#AAAAAA" />
                                    <TextBlock Text="{Binding Temperature, StringFormat={}{0:F2}}" Foreground="#00D4AA" />
                                </StackPanel>
                                <Slider Minimum="0.0" Maximum="2.0" Value="{Binding Temperature}" TickFrequency="0.1" IsSnapToTickEnabled="True" />

                                <TextBlock Text="{l:T sidebar.params.maxTokens}" Foreground="#E0E0E0" FontSize="10" Margin="0,10,0,5" />
                                <ComboBox ItemsSource="{Binding MaxTokensOptions}" Style="{StaticResource ModernComboBox}" SelectedItem="{Binding SelectedMaxTokens}" DisplayMemberPath="Label" />
                            </StackPanel>

                            <!-- Búsqueda web: solo si el binario la incluye -->
                            <StackPanel Margin="0,0,0,16"
                                        Visibility="{Binding IsWebSearchCompiledIn, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{l:T sidebar.web.header}" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />

                                <TextBlock Text="{l:T sidebar.web.instance}" Foreground="#E0E0E0" FontSize="10" Margin="0,0,0,4" />
                                <TextBox x:Name="SearxngUrlBox"
                                         AutomationProperties.AutomationId="SearxngUrlBox"
                                         Text="{Binding SearxngUrl, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                         Background="#1E293B" Foreground="#E0E0E0"
                                         BorderBrush="#334155" BorderThickness="1" Padding="6,4"
                                         FontFamily="{StaticResource MonoFont}" FontSize="10" />
                                <TextBlock Text="{Binding WebSearchConfigStatus}" FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#F59E0B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWebSearchConfigured}" Value="True">
                                                    <Setter Property="Foreground" Value="#10B981" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="{l:T sidebar.web.freshness}" Foreground="#E0E0E0" FontSize="10" Margin="0,10,0,4" />
                                <ComboBox ItemsSource="{Binding FreshnessOptions}" Style="{StaticResource ModernComboBox}"
                                          SelectedItem="{Binding SelectedFreshness}" DisplayMemberPath="Label" />

                                <TextBlock Text="{Binding WebSearchToggleTooltip}" Foreground="#64748b" FontSize="9"
                                           TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer de sidebar -->
                    <StackPanel Grid.Row="4" Margin="0,16,0,0">
                        <Button Command="{Binding GoBackCommand}" Style="{StaticResource TransparentHoverButton}" HorizontalAlignment="Left" Padding="8,4" Margin="-8,0,0,8"
                                AutomationProperties.AutomationId="BackToStartButton"
                                AutomationProperties.Name="{l:T sidebar.backToStart}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Kind="ArrowBack" Size="14" Foreground="#AAAAAA" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{l:T sidebar.backToStart}" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding GpuInfo}" Foreground="#777777" FontFamily="{StaticResource MonoFont}" FontSize="10" VerticalAlignment="Bottom" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- PANEL DERECHO (solo visible en modo investigación) -->
        <Border Grid.Column="1" Background="#16213E" BorderBrush="#2A2A4A" BorderThickness="1,0,0,0" Padding="15"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header Contexto -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="{l:T context.title}" Foreground="#00D4AA" FontWeight="Bold" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource TransparentHoverButton}" Click="CollapseRightPanel_Click"
                            AutomationProperties.Name="{l:T context.close}" ToolTip="{l:T context.close}">
                        <c:Icon Kind="Close" Size="14" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <!-- Placeholder cuando no hay artefactos -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LoadedArtifactsList.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Rectangle Stroke="#777777" StrokeThickness="1" StrokeDashArray="4 4" Fill="Transparent" />
                        <TextBlock Text="{l:T context.empty}" Foreground="#777777" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                    </Grid>

                    <!-- Lista de artefactos cargados -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LoadedArtifactsList.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding LoadedArtifactsList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E3A" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FileName}" Foreground="#E0E0E0" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FileType}" Foreground="#10B981" FontSize="9" Margin="0,2,8,0"/>
                                                    <TextBlock Text="{Binding FileSizeFormatted}" Foreground="#777777" FontSize="9" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Command="{Binding RemoveCommand}"
                                                    Style="{StaticResource TransparentHoverButton}"
                                                    Foreground="#EF4444"
                                                    AutomationProperties.Name="{l:T context.remove}" ToolTip="{l:T context.remove}"
                                                    Width="24" Height="24" VerticalAlignment="Center">
                                                <c:Icon Kind="Close" Size="12" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Footer métricas -->
                <StackPanel Grid.Row="2" Margin="0,20,0,0">
                    <TextBlock Text="{Binding EstimatedTokens, StringFormat={l:T context.tokensFormat}}" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#AAAAAA" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNearContextLimit}" Value="True">
                                        <Setter Property="Foreground" Value="#F59E0B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ContextAvailableText}" FontSize="10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#777777" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNearContextLimit}" Value="True">
                                        <Setter Property="Foreground" Value="#F59E0B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                Visibility="{Binding IsNearContextLimit, Converter={StaticResource BoolToVis}}">
                        <c:Icon Kind="Warning" Size="12" Foreground="#F59E0B" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:T context.nearLimit}" FontSize="10" Foreground="#F59E0B" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding LoadedArtifacts, StringFormat={l:T context.artifactsFormat}}" Foreground="#777777" FontSize="11" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

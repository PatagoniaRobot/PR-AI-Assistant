<UserControl x:Class="PRImager.AIAssistant.Views.ModeSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PRImager.AIAssistant.Views"
             xmlns:vm="clr-namespace:PRImager.AIAssistant.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ModeSelectionViewModel}"
             Background="#1a1a2e" FontFamily="{StaticResource MainFont}"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <UserControl.Resources>
        <!-- Estilo base para los botones-tarjeta -->
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0f172a" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="Foreground" Value="#e2e8f0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#10B981"/>
                                <!-- Efecto de elevación sutil -->
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#10B981" BlurRadius="10" ShadowDepth="0" Opacity="0.3" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#16213E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para los botones de texto del footer -->
        <Style x:Key="FooterButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="txt" 
                                   Text="{TemplateBinding Content}" 
                                   Background="Transparent"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="txt" Property="Foreground" Value="#94a3b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BulletText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#cbd5e1"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="BulletIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#10B981"/>
            <Setter Property="Text" Value="✓"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,24">
            
            <!-- Logo / Header -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                <Image Source="pack://application:,,,/Assets/logo_sidebar_40.png"
                       Width="36" Height="36" Margin="0,0,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="PR-AI Assistant" 
                           Foreground="#10B981" 
                           FontWeight="SemiBold" 
                           FontSize="28" 
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding VersionText}" Foreground="#64748b" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,40" />

            <!-- Cards Container -->
            <WrapPanel HorizontalAlignment="Center" MaxWidth="680" ItemWidth="320">
                <!-- CARD IZQUIERDA - Modo Investigación -->
                <Button Style="{StaticResource CardButtonStyle}"
                        AutomationProperties.AutomationId="ModeInvestigationCard"
                        Command="{Binding SelectInvestigationCommand}"
                        Margin="0,0,20,20">
                    <StackPanel Margin="32">
                        <TextBlock Text="🔍" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Modo Investigación" Foreground="#10B981" FontWeight="SemiBold" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Análisis de evidencia con&#x0a;cadena de custodia" Foreground="#94a3b8" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24"/>
                        
                        <StackPanel Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource BulletIcon}"/><TextBlock Text="Formulario de identificación" Style="{StaticResource BulletText}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource BulletIcon}"/><TextBlock Text="Acceso al Blackboard" Style="{StaticResource BulletText}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource BulletIcon}"/><TextBlock Text="Logging forense completo" Style="{StaticResource BulletText}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource BulletIcon}"/><TextBlock Text="Exportación de sesión" Style="{StaticResource BulletText}"/></StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- CARD DERECHA - Modo Consulta -->
                <Button Style="{StaticResource CardButtonStyle}"
                        AutomationProperties.AutomationId="ModeConsultationCard"
                        Command="{Binding SelectConsultationCommand}"
                        Margin="0,0,0,20">
                    <StackPanel Margin="32">
                        <TextBlock Text="🎓" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Academia PR" Foreground="#10B981" FontWeight="SemiBold" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Consultas técnicas y legales&#x0a;sin acceso a evidencia" Foreground="#94a3b8" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24"/>
                        
                        <StackPanel Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource BulletIcon}"/><TextBlock Text="Legislación y normativa" Style="{StaticResource BulletText}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource BulletIcon}"/><TextBlock Text="Conceptos de informática forense" Style="{StaticResource BulletText}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource BulletIcon}"/><TextBlock Text="Sandbox completamente aislado" Style="{StaticResource BulletText}"/></StackPanel>
                        </StackPanel>
                        
                        <Border Background="#92400e" CornerRadius="10" Padding="12,4" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock Text="SANDBOX AISLADO" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <!-- Separador -->
            <Rectangle Height="1" Width="660" Fill="#334155" Margin="0,12,0,32" HorizontalAlignment="Center" />

            <!-- Selector de Modelo y Perfil -->
            <StackPanel Width="660" HorizontalAlignment="Center" Margin="0,0,0,32">
                <TextBlock Text="MODELO" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Style="{StaticResource ModernComboBox}"
                              ItemsSource="{Binding AvailableModelItems}"
                              SelectedItem="{Binding SelectedModelItem}"
                              DisplayMemberPath="DisplayName" />
                </Grid>
                <!-- Info del modelo -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Foreground="#00D4AA" FontSize="11" Margin="0,0,6,0" Text="{Binding SelectedModelHardwareTag, Mode=OneWay}"/>
                    <TextBlock Text="{Binding SelectedModelCapabilitiesText}" Foreground="#3B82F6" FontSize="11" />
                </StackPanel>

                <!-- Ejecución -->
                <TextBlock Text="EJECUCIÓN" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" Margin="0,24,0,8" />
                <ItemsControl ItemsSource="{Binding AvailableExecutionProfiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding DisplayName}"
                                    Command="{Binding DataContext.SelectExecutionProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand" FontSize="12" FontWeight="SemiBold" Margin="2,0" MinHeight="32">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Foreground" Value="#e2e8f0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="#334155"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6" Padding="8,4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#1e293b"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="#10B981"/>
                                                <Setter Property="Foreground" Value="#0f172a"/>
                                                <Setter Property="BorderBrush" Value="#10B981"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding SelectedModelContextInfo}"
                           Foreground="#64748b" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Separador -->
            <Rectangle Height="1" Width="660" Fill="#334155" Margin="0,0,0,24" HorizontalAlignment="Center" />

            <!-- Pie de página con botones -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <Button Content="Ayuda" Style="{StaticResource FooterButtonStyle}" Command="{Binding HelpCommand}"/>
                <TextBlock Text=" · " Foreground="#64748b" FontSize="12" VerticalAlignment="Center" Margin="4,0"/>
                <Button Content="Licencias" Style="{StaticResource FooterButtonStyle}" Command="{Binding LicensesCommand}"/>
            </StackPanel>

            <TextBlock Text="PR-AI Assistant © 2026 Patagonia Robot" 
                       Foreground="#475569" 
                       FontSize="11" 
                       HorizontalAlignment="Center" />
                       
        </StackPanel>
    </ScrollViewer>
</UserControl>

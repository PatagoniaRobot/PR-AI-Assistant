<Window x:Class="PRImager.AIAssistant.Views.ProfileManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PRImager.AIAssistant.Views.Converters"
        xmlns:vm="clr-namespace:PRImager.AIAssistant.ViewModels"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        d:DataContext="{d:DesignInstance Type=vm:ProfileManagerViewModel}"
        Title="Perfiles de uso — PR-AI Assistant"
        Height="620" Width="900"
        Background="#1A1A2E"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource MainFont}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:HexToBrushConverter x:Key="HexToBrush" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94a3b8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#16213E" />
                    <Setter Property="Foreground" Value="#64748b" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#64748b" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#374151" />
                                <Setter Property="Foreground" Value="#6B7280" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#DC2626" />
        </Style>

        <Style x:Key="NeutralDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#334155" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
            <TextBlock Text="Perfiles de uso" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="Los perfiles de fábrica no se editan ni se borran. Cloná uno para partir de su configuración."
                       Foreground="#94a3b8" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Lista de perfiles -->
        <Border Grid.Row="1" Grid.Column="0" Background="#0f172a" BorderBrush="#334155" BorderThickness="1" CornerRadius="6">
            <ListBox ItemsSource="{Binding Profiles}"
                     SelectedItem="{Binding SelectedProfile}"
                     Background="Transparent" BorderThickness="0" Foreground="#E0E0E0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Rectangle Width="4" Height="28" Margin="0,0,10,0"
                                       Fill="{Binding AccentColor, Converter={StaticResource HexToBrush}}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="de fábrica" Foreground="#64748b" FontSize="10"
                                           Visibility="{Binding IsFactory, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Editor -->
        <Border Grid.Row="1" Grid.Column="2" Background="#0f172a" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <!-- Aviso de perfil de fábrica -->
                    <Border Background="#422006" BorderBrush="#B45309" BorderThickness="1" CornerRadius="4" Padding="10"
                            Visibility="{Binding IsFactorySelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Foreground="#FCD34D" FontSize="11" TextWrapping="Wrap"
                                   Text="Perfil de fábrica: solo lectura. Usá «Clonar» para crear una copia editable." />
                    </Border>

                    <TextBlock Text="NOMBRE" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsEditable}" />

                    <TextBlock Text="PROMPT DE SISTEMA" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditSystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsEditable}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="180"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource MonoFont}" FontSize="12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TEMPERATURA" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding EditTemperature, StringFormat={}{0:F2}}" IsEnabled="{Binding IsEditable}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CONTEXTO (TOKENS)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding EditContextTokens}" IsEnabled="{Binding IsEditable}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="COLOR DE ACENTO" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding EditAccentColor, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsEditable}" FontFamily="{StaticResource MonoFont}" />
                                <Rectangle Grid.Column="1" Width="28" Margin="6,0,0,0"
                                           Fill="{Binding EditAccentColor, Converter={StaticResource HexToBrush}}" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="CAPACIDADES" Style="{StaticResource FieldLabel}" />
                    <CheckBox IsChecked="{Binding EditWebSearchEnabled}" IsEnabled="{Binding IsEditable}"
                              Content="Búsqueda web habilitada" />
                    <CheckBox IsChecked="{Binding EditModelDownloadEnabled}" IsEnabled="{Binding IsEditable}"
                              Content="Descarga de modelos habilitada" />
                    <CheckBox IsChecked="{Binding EditMandatoryLog}" IsEnabled="{Binding IsEditable}"
                              Content="Registro de auditoría obligatorio" />

                    <TextBlock Text="En Modo Investigación estas tres quedan forzadas — sin web, sin descargas, con registro obligatorio — sin importar lo que diga el perfil."
                               Foreground="#64748b" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Barra de acciones -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Clonar" Command="{Binding CloneCommand}" Style="{StaticResource DialogButton}" />
                <Button Content="Guardar" Command="{Binding SaveCommand}" Style="{StaticResource DialogButton}" />
                <Button Content="Eliminar" Command="{Binding DeleteCommand}" Style="{StaticResource DangerDialogButton}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="#10B981" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <Button Content="Cerrar" Command="{Binding CloseCommand}" Style="{StaticResource NeutralDialogButton}"
                    HorizontalAlignment="Right" Margin="0" />
        </Grid>
    </Grid>
</Window>

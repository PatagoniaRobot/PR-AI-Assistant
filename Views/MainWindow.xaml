<Window x:Class="PRImager.AIAssistant.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PRImager.AIAssistant.ViewModels"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="800" 
        Width="1200"
        Background="#1A1A2E"
        WindowStartupLocation="CenterScreen"
        FontFamily="Consolas"
        Closing="Window_Closing">

    <Grid Background="#1A1A2E">
        <!-- Contenedor de navegación: muestra la vista activa -->
        <ContentControl Content="{Binding CurrentView}"/>
    </Grid>
</Window>
